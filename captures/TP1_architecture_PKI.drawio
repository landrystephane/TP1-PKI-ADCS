<mxfile host="app.diagrams.net">
  <diagram id="pki-alpina" name="Architecture PKI ALPINA">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;ALPINA SERVICES – Architecture PKI cible (Root CA hors ligne + Issuing CA)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="0" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="zOff" value="Zone isolée (hors ligne, hors domaine)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fdecea;strokeColor=#c0392b;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#c0392b;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="zHttp" value="Publication HTTP (CDP / AIA)" style="rounded=1;arcSize=4;fillColor=#eaf4fb;strokeColor=#2471a3;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#2471a3;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="40" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="zDom" value="Domaine Active Directory alpina.test" style="rounded=1;arcSize=2;fillColor=#eafaf1;strokeColor=#1e8449;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#1e8449;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="250" width="680" height="400" as="geometry" />
        </mxCell>

        <mxCell id="root" value="&lt;b&gt;Root CA&lt;/b&gt;&lt;br&gt;ALPINA-ROOT-CA&lt;br&gt;&lt;i&gt;hors ligne, éteinte&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="http" value="&lt;b&gt;Serveur HTTP&lt;/b&gt;&lt;br&gt;http://pki.alpina.test&lt;br&gt;CRL + certificats des AC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2471a3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="issuing" value="&lt;b&gt;Issuing CA&lt;/b&gt;&lt;br&gt;ALPINA-ISSUING-CA&lt;br&gt;Enterprise CA jointe au domaine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="iis" value="&lt;b&gt;Serveur IIS&lt;/b&gt;&lt;br&gt;intranet.alpina.test&lt;br&gt;certificat serveur (SAN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dc" value="&lt;b&gt;DC / DNS&lt;/b&gt;&lt;br&gt;Active Directory, DNS, GPO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Poste client&lt;/b&gt;&lt;br&gt;Windows 11&lt;br&gt;navigateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="540" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="① Signature du certificat de l'Issuing CA&lt;br&gt;(transfert hors ligne, clé USB)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="root" target="issuing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" value="③ Publication CRL racine&lt;br&gt;(copie manuelle)" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#c0392b;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="root" target="http">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="③ Publication CRL / AIA&lt;br&gt;de l'Issuing CA" style="html=1;endArrow=block;endFill=1;strokeColor=#2471a3;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="issuing" target="http">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="② Émission du certificat serveur&lt;br&gt;(CSR, modèle « Serveur Web »)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#1e8449;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="issuing" target="iis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="④ Requête HTTPS&lt;br&gt;+ présentation de la chaîne&lt;br&gt;(IIS → Issuing CA → Root CA)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#7d3c98;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="iis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="⑤ Contrôle de révocation (CRL)&lt;br&gt;+ récupération AIA" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d68910;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="http">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="580" />
              <mxPoint x="780" y="120" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="⑥ Distribution de la racine&lt;br&gt;par GPO" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#1e8449;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dc" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Modèles, auto-enrollment,&lt;br&gt;publication dans AD" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#1e8449;strokeWidth=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="issuing" target="dc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Légende des flux&lt;/b&gt;&lt;br&gt;① Chaîne de certification : la racine signe l'AC émettrice&lt;br&gt;② Émission : l'AC émettrice signe le certificat d'IIS&lt;br&gt;③ Publication des CRL et certificats d'AC en HTTP&lt;br&gt;④ Demande HTTPS : IIS présente son certificat et la chaîne&lt;br&gt;⑤ Contrôle de révocation par le client&lt;br&gt;⑥ Confiance : la racine est installée sur tous les postes" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#999999;fillColor=#fafafa;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="830" y="40" width="300" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
